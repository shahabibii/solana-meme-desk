# Desk mode — use paper for Fomo Copy Mode v1
DESK_MODE=paper

# Fomo Copy Mode (smart-money signals only; disables raw pump launch firehose)
FOMO_COPY_MODE=true
PUMP_LAUNCH_FEED=false
COPE_POLL_SEC=20
FOMO_HANDLE=your_fomo_handle

# Solana / execution
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# Feeds
COPE_API_KEY=
PUMPPORTAL_API_KEY=

# Optional
OPENAI_API_KEY=
RESEARCH_LLM_ENABLED=false
ELEVENLABS_API_KEY=
ALERT_WEBHOOK_URL=
SNIPER_INGEST_SECRET=
