# Orchestrator — copy to .env (never commit .env)

DESK_MODE=paper
MOCK_STREAM=false
PAPER_STARTING_SOL=1.0
SAFETY_MIN_SCORE=65
ENTRY_MIN_SCORE=72

# Solana RPC (public ok for safety checks; use Helius for production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Live mode (optional)
# SOLANA_PRIVATE_KEY=base58...

# fomo.family smart money via Cope Capital
# Register: POST https://api.cope.capital/v1/register
# COPE_API_KEY=cope_...

# PumpPortal (optional; new-token stream works without key)
# PUMPPORTAL_API_KEY=
