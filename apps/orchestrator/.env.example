# Orchestrator — copy to .env (never commit .env)

DESK_MODE=paper
MOCK_STREAM=false
PAPER_STARTING_SOL=1.0
SAFETY_MIN_SCORE=65
ENTRY_MIN_SCORE=72
COPE_POLL_SEC=60

# ── Solana RPC ─────────────────────────────────────────────
# Public RPC works for safety checks; use Helius/QuickNode for production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Helius (optional) — RPC + Yellowstone gRPC sniper
# HELIUS_API_KEY=

# Yellowstone gRPC (optional — sniper-rs; defaults to Helius endpoint)
# YELLOWSTONE_GRPC_ENDPOINT=https://grpc.helius-rpc.com
# YELLOWSTONE_GRPC_X_TOKEN=

# ── Live wallet (optional) ─────────────────────────────────
# Base58 private key for PumpPortal trade-local signing (non-custodial)
# SOLANA_PRIVATE_KEY=

# ── Onyx voice (ElevenLabs Maisie) ─────────────────────────
# Without this key, Onyx falls back to browser TTS + bundled preview clip.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=QtY3JBOUKEB5xzrRfOKc
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Deep safety (Rugcheck.xyz — on by default)
# RUGCHECK_ENABLED=true

# Research LLM summaries (optional)
# OPENAI_API_KEY=
# RESEARCH_LLM_ENABLED=true
# OPENAI_MODEL=gpt-4o-mini

# ── fomo.family smart money (Cope Capital) ─────────────────
# Register: POST https://api.cope.capital/v1/register
# COPE_API_KEY=cope_...

# PumpPortal — stream + copy-trading (subscribeAccountTrade requires funded API key)
# PUMPPORTAL_API_KEY=

# Live trade tuning
TRADE_SLIPPAGE_PCT=12
TRADE_PRIORITY_FEE_SOL=0.0005
TRADE_POOL=auto

# ── Jito bundles (optional) ────────────────────────────────
USE_JITO=false
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=100000

# ── Sniper hot-path ingest ─────────────────────────────────
# Shared secret for apps/sniper → POST /api/ingest/candidate
# SNIPER_INGEST_SECRET=change-me
ORCHESTRATOR_URL=http://127.0.0.1:8787

# ── Production (Fly / Docker) ──────────────────────────────
# DATA_DIR=/data
# CONFIG_DIR=/config
# STATIC_DIR=/app/static
# PORT=8787
